# Supabase — OBOLO project
# Project ref: xhipmlagwmybyiqxdzrz
NEXT_PUBLIC_SUPABASE_URL=https://xhipmlagwmybyiqxdzrz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never expose to the browser, never prefix NEXT_PUBLIC_.
# Used by scheduled jobs: nightly valuation snapshots, integrity checks, AI insights.
SUPABASE_SERVICE_ROLE_KEY=

# Vercel AI Gateway. Supplied automatically on Vercel; set locally for `next dev`.
AI_GATEWAY_API_KEY=

# Shared secret for cron-triggered route handlers (/api/insights, snapshots).
CRON_SECRET=

# Break-glass system administrator, provisioned by `npm run admin:create`.
# Leave the password blank: the script generates a strong one and prints it
# once. A default admin password committed to a repo is a way in, not a tool.
OBOLO_SYSTEM_ADMIN_EMAIL=
OBOLO_SYSTEM_ADMIN_NAME=Systems Administrator
OBOLO_SYSTEM_ADMIN_PASSWORD=
